# Copie para .env e preencha com os dados do seu projeto Supabase.
# Estas duas chaves são públicas (ficam no app). Nunca coloque chaves secretas aqui.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-ou-publishable-key

# --- Modo online com Firebase (Firestore + Gemini com busca no Google, plano gratuito) ---
# O app já vem apontando para o projeto Firebase do jogo (src/services/firebase.ts). Preencha só
# para usar OUTRO projeto (valores do "firebaseConfig" do app Web; também são públicos).
# Para usar o Supabase no lugar do Firebase: EXPO_PUBLIC_ONLINE_BACKEND=supabase
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Opcional: modelo do Gemini (os "Flash-Lite" têm a maior cota gratuita).
# EXPO_PUBLIC_GEMINI_MODEL=gemini-3.1-flash-lite
