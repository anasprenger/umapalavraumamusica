{
  "expo": {
    "name": "Uma Palavra, Uma Música",
    "slug": "uma-palavra-uma-musica",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "umapalavra",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F5FC",
    "primaryColor": "#6B3FE0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.umapalavraumamusica.app"
    },
    "android": {
      "package": "com.umapalavraumamusica.app",
      "adaptiveIcon": {
        "backgroundColor": "#5B2FD0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Uma Palavra, Uma Música",
      "shortName": "Uma Palavra",
      "themeColor": "#6B3FE0",
      "backgroundColor": "#F7F5FC"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5B2FD0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
