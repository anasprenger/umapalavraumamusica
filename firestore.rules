rules_version = '2';

// Modo online com Firebase. As regras do JOGO rodam no app, dentro de transações do Firestore
// (src/game/online/rules.ts). Aqui o banco garante o básico:
// - só quem entrou (login anônimo) lê e grava;
// - só membros da sala alteram a sala, ou alguém entrando nela (acrescentando só a si mesmo);
// - cada jogador grava apenas o próprio voto e o próprio sinal de presença;
// - salas nunca são apagadas pelo app.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /rooms/{code} {
      function isMember() {
        return request.auth.uid in resource.data.members;
      }

      function joining() {
        return request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members;
      }

      allow read: if signedIn();
      allow create: if signedIn()
        && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.code == code
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.hostPlayerId == request.auth.uid;
      allow update: if signedIn()
        && request.resource.data.code == resource.data.code
        && (isMember() || joining());
      allow delete: if false;

      match /votes/{uid} {
        allow read: if signedIn();
        allow write: if signedIn()
          && request.auth.uid == uid
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(code)).data.members;
      }

      match /presence/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}
